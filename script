ESPEnabled = false
function ESPBClick()
	if not ESPEnabled then
		ESPEnabled = true
		ESPB.TextColor3 = Color3.new(0, 1, 0)
		for _, v in pairs(ESPFolder:GetChildren()) do
			if v:IsA("BillboardGui") then
				v.Enabled = true
			end
		end
	else
		ESPEnabled = false
		ESPB.TextColor3 = Color3.new(0, 0, 0)
		for _, v in pairs(ESPFolder:GetChildren()) do
			if v:IsA("BillboardGui") then
				v.Enabled = false
			end
		end
	end
end

ShotRemote = game.ReplicatedStorage.Remotes.ShotRemote
function KillPlr()
	KillB.TextColor3 = Color3.new(0, 1, 0)
	local data = {
		Shots = tonumber(TextBoxShotsDelay.Text:split("/")[1]),
		Delay = tonumber(TextBoxShotsDelay.Text:split("/")[2]),
		Username = TextBoxTarget.Text
	}
	if game.Players:FindFirstChild(data.Username) then
		local targethead = game.Players:FindFirstChild(data.Username).Character:WaitForChild("Head")
		for i = 1,data.Shots do
			local args = {
				{targethead.Position.X + math.random(0, 1) / 100000,targethead.Position.Y + math.random(0, 1) / 100000,targethead.Position.Z + math.random(0, 1) / 100000},
				targethead,
				vector.create(targethead.Position.X + math.random(0, 1) / 100000,targethead.Position.Y + math.random(0, 1) / 100000,targethead.Position.Z + math.random(0, 1) / 100000)
			}
			ShotRemote:FireServer(unpack(args))
			wait(data.Delay)
		end
	end
	KillB.TextColor3 = Color3.new(0, 0, 0)
end

TextBoxTarget.InputEnded:Connect(function()
	for _, v in pairs(ESPFolder:GetChildren()) do
		if v:IsA("BillboardGui") then
			if v:FindFirstChild("G") then
				v.G.TextColor3 = Color3.new(1, 1, 1)
			end
		end
	end
	if ESPFolder:FindFirstChild(TextBoxTarget.Text) then
		ESPFolder:FindFirstChild(TextBoxTarget.Text).G.TextColor3 = Color3.new(1, 0, 0)
	end
end)

TrackPLR = false
function TrackPlayer()
	if not TrackPLR then
		local plr = SpectateUsernameTextBox.Text
		if game.Players:FindFirstChild(plr) then
			TrackPLR = true
			SpectateB.TextColor3 = Color3.new(0, 1, 0)
			for _, m in ESPFolder do
				if m:IsA("BoxHandleAdornment") and m:GetAttribute("OWNER") == plr then
					m.Transparency = 0.3
				end
			end
		end
	else
		TrackPLR = false
		SpectateB.TextColor3 = Color3.new(0, 0, 0)
		for _, m in ESPFolder do
			if m:IsA("BoxHandleAdornment") then
				m.Transparency = 1
			end
		end
	end
end

ESPB.MouseButton1Click:Connect(ESPBClick)
KillB.MouseButton1Click:Connect(KillPlr)
SpectateB.MouseButton1Click:Connect(TrackPlayer)
