function CreateESP()
	for _, player in pairs(game.Players:GetChildren()) do
		local a = Instance.new("BillboardGui")
		a.Name = player.Name
		a.Size = UDim2.new(5, 0, 1.5, 0)
		a.StudsOffset = Vector3.new(0, 2, 0)
		a.AlwaysOnTop = true
		a.Enabled = false
		a.Adornee = player.Character:WaitForChild("Head")
		a.Parent = ESPFolder
		local b = Instance.new("TextLabel")
		b.Name = "G"
		b.BackgroundTransparency = 1
		b.Text = player.Name.." | HP: "..player.Character:FindFirstChildOfClass("Humanoid").Health
		b.Size = UDim2.new(1, 0, 1, 0)
		b.TextScaled = true
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.DenkOne
		b.FontFace.Bold = true
		b.ZIndex = 10
		b.Parent = a
		local humcon = nil
		repeat wait() until player.Character
		repeat wait() until player.Character:FindFirstChildOfClass("Humanoid")
		humcon = player.Character:FindFirstChildOfClass("Humanoid").Changed:Connect(function()
			if not player.Character:FindFirstChildOfClass("Humanoid") then humcon = nil;return end
			if player.Character:FindFirstChildOfClass("Humanoid").Health == 0 then humcon = nil end
			b.Text = player.Name.." | HP: "..player.Character:FindFirstChildOfClass("Humanoid").Health
		end)
		player.CharacterAdded:Connect(function(char)
			repeat wait() until char:FindFirstChildOfClass("Humanoid")
			a.Adornee = char:WaitForChild("Head")
			humcon = char:FindFirstChildOfClass("Humanoid").Changed:Connect(function()
				if not player.Character:FindFirstChildOfClass("Humanoid") then humcon = nil;return end
				if player.Character:FindFirstChildOfClass("Humanoid").Health == 0 then humcon = nil end
				b.Text = player.Name.." | HP: "..char:FindFirstChildOfClass("Humanoid").Health
			end)
		end)
	end
	game.Players.PlayerAdded:Connect(function(player)
		local a = Instance.new("BillboardGui")
		a.Name = player.Name
		a.Size = UDim2.new(5, 0, 1.5, 0)
		a.StudsOffset = Vector3.new(0, 2, 0)
		a.AlwaysOnTop = true
		if not ESPEnabled then
			a.Enabled = false
		else
			a.Enabled = true
		end
		a.Parent = ESPFolder
		local b = Instance.new("TextLabel")
		b.Name = "G"
		b.BackgroundTransparency = 1
		b.Size = UDim2.new(1, 0, 1, 0)
		b.TextScaled = true
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.DenkOne
		b.FontFace.Bold = true
		b.ZIndex = 10
		b.Parent = a
		local humcon = nil
		repeat wait() until player.Character
		repeat wait() until player.Character:FindFirstChildOfClass("Humanoid")
		a.Adornee = player.Character:WaitForChild("Head")
		b.Text = player.Name.." | HP: "..player.Character:FindFirstChildOfClass("Humanoid").Health
		humcon = player.Character:FindFirstChildOfClass("Humanoid").Changed:Connect(function()
			if not player.Character:FindFirstChildOfClass("Humanoid") then humcon = nil;return end
			if player.Character:FindFirstChildOfClass("Humanoid").Health == 0 then humcon = nil end
			b.Text = player.Name.." | HP: "..player.Character:FindFirstChildOfClass("Humanoid").Health
		end)
		player.CharacterAdded:Connect(function(char)
			repeat wait() until char:FindFirstChildOfClass("Humanoid")
			a.Adornee = char:WaitForChild("Head")
			humcon = char:FindFirstChildOfClass("Humanoid").Changed:Connect(function()
				if not player.Character:FindFirstChildOfClass("Humanoid") then humcon = nil;return end
				if player.Character:FindFirstChildOfClass("Humanoid").Health == 0 then humcon = nil end
				b.Text = player.Name.." | HP: "..char:FindFirstChildOfClass("Humanoid").Health
			end)
		end)
	end)
	game.Players.PlayerRemoving:Connect(function(plr)
		if ESPFolder:FindFirstChild(plr.Name) then
			ESPFolder:FindFirstChild(plr.Name):Destroy()
		end
	end)
end

CreateESP()

ESPEnabled = false
function ESPBClick()
	if not ESPEnabled then
		ESPEnabled = true
		ESPB.TextColor3 = Color3.new(0, 1, 0)
		for _, v in pairs(ESPFolder:GetChildren()) do
			if v:IsA("BillboardGui") then
				v.Enabled = true
			end
		end
	else
		ESPEnabled = false
		ESPB.TextColor3 = Color3.new(0, 0, 0)
		for _, v in pairs(ESPFolder:GetChildren()) do
			if v:IsA("BillboardGui") then
				v.Enabled = false
			end
		end
	end
end

ShotRemote = game.ReplicatedStorage.Remotes.ShotRemote
function KillPlr()
	KillB.TextColor3 = Color3.new(0, 1, 0)
	local data = {
		Shots = tonumber(TextBoxShotsDelay.Text:split("/")[1]),
		Delay = tonumber(TextBoxShotsDelay.Text:split("/")[2]),
		Username = TextBoxTarget.Text
	}
	if game.Players:FindFirstChild(data.Username) then
		local targethead = game.Players:FindFirstChild(data.Username).Character:WaitForChild("Head")
		for i = 1,data.Shots do
			local args = {
				{targethead.Position.X + math.random(0, 1) / 100000,targethead.Position.Y + math.random(0, 1) / 100000,targethead.Position.Z + math.random(0, 1) / 100000},
				targethead,
				vector.create(targethead.Position.X + math.random(0, 1) / 100000,targethead.Position.Y + math.random(0, 1) / 100000,targethead.Position.Z + math.random(0, 1) / 100000)
			}
			ShotRemote:FireServer(unpack(args))
			wait(data.Delay)
		end
	end
	KillB.TextColor3 = Color3.new(0, 0, 0)
end

TextBoxTarget.InputEnded:Connect(function()
	for _, v in pairs(ESPFolder:GetChildren()) do
		if v:IsA("BillboardGui") then
			if v:FindFirstChild("G") then
				v.G.TextColor3 = Color3.new(1, 1, 1)
			end
		end
	end
	if ESPFolder:FindFirstChild(TextBoxTarget.Text) then
		ESPFolder:FindFirstChild(TextBoxTarget.Text).G.TextColor3 = Color3.new(1, 0, 0)
	end
end)

ESPB.MouseButton1Click:Connect(ESPBClick)
KillB.MouseButton1Click:Connect(KillPlr)
