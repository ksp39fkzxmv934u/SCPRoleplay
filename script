function CreateESP()
	for _, player in pairs(game.Players:GetChildren()) do
		spawn(function()
			local a = Instance.new("BillboardGui")
			a.Name = player.Name
			a.Size = UDim2.new(0, 100, 0, 100)
			a.StudsOffset = Vector3.new(0, 3, 0)
			a.AlwaysOnTop = true
			a.Enabled = false
			a.Parent = ESPFolder
			local b = Instance.new("TextLabel")
			b.Name = "G"
			b.BackgroundTransparency = 1
			b.Size = UDim2.new(1, 0, 1, 0)
			b.TextSize = 20
			b.TextColor3 = Color3.new(1, 1, 1)
			b.Font = Enum.Font.DenkOne
			b.FontFace.Bold = true
			b.ZIndex = 10
			b.Parent = a
			repeat wait() until player.Character
			repeat wait() until player.Character:FindFirstChildOfClass("Humanoid")
			repeat wait() until player.Character:FindFirstChild("HumanoidRootPart")
			a.Adornee = player.Character.HumanoidRootPart
			b.Text = player.Name.." | HP: "..player.Character:FindFirstChildOfClass("Humanoid").Health
			local ESPBXF = {}
			local Connections = {1, 2}
			for b,n in pairs(player.Character:GetChildren()) do
				if (n:IsA("BasePart")) then
					local a = Instance.new("BoxHandleAdornment")
					a.Name = player.Name.."BOX|"..n.Name
					a.Parent = ESPFolder
					a.Adornee = n
					a.AlwaysOnTop = true
					a.ZIndex = 10
					a.Size = n.Size
					a.Transparency = 1
					a.Color3 = Color3.new(1, 1, 1)
					a:SetAttribute("OWNER", player.Name)
					table.insert(ESPBXF, a)
				end
			end
			local function SetConnections()
				Connections[1] = player.Character:FindFirstChildOfClass("Humanoid").Changed:Connect(function()
					if player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
						b.Text = player.Name.." | HP: "..player.Character:FindFirstChildOfClass("Humanoid").Health
					end
				end)
				Connections[2] = player.Character:FindFirstChildOfClass("Humanoid").Died:Connect(function()
					b.Text = player.Name.." | DIED"
					Connections[1] = 1
					Connections[1] = 2
				end)
				for _, q in pairs(ESPBXF) do
					if player.Character:FindFirstChild(q.Name:split("|")[2]) then
						q.Adornee = player.Character:FindFirstChild(q.Name:split("|")[2])
					end
				end
			end
			player.CharacterAdded:Connect(function(char)
				repeat wait() until char:FindFirstChildOfClass("Humanoid")
				repeat wait() until char:FindFirstChild("HumanoidRootPart")
				SetConnections()
			end)
			spawn(function()
				while true do
					if player.Character then
						if player.Character:FindFirstChild("Head") then
							a.Adornee = player.Character.HumanoidRootPart
						end
					end
					wait(3)
				end
			end)
		end)
	end
	game.Players.PlayerAdded:Connect(function(player)
		local a = Instance.new("BillboardGui")
		a.Name = player.Name
		a.Size = UDim2.new(0, 100, 0, 100)
		a.StudsOffset = Vector3.new(0, 3, 0)
		a.AlwaysOnTop = true
		a.Enabled = false
		a.Parent = ESPFolder
		local b = Instance.new("TextLabel")
		b.Name = "G"
		b.BackgroundTransparency = 1
		b.Size = UDim2.new(1, 0, 1, 0)
		b.TextSize = 20
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.DenkOne
		b.FontFace.Bold = true
		b.ZIndex = 10
		b.Parent = a
		repeat wait() until player.Character
		repeat wait() until player.Character:FindFirstChildOfClass("Humanoid")
		repeat wait() until player.Character:FindFirstChild("HumanoidRootPart")
		a.Adornee = player.Character.HumanoidRootPart
		b.Text = player.Name.." | HP: "..player.Character:FindFirstChildOfClass("Humanoid").Health
		local ESPBXF = {}
		local Connections = {1, 2}
		for b,n in pairs(player.Character:GetChildren()) do
			if (n:IsA("BasePart")) then
				local a = Instance.new("BoxHandleAdornment")
				a.Name = player.Name.."BOX|"..n.Name
				a.Parent = ESPFolder
				a.Adornee = n
				a.AlwaysOnTop = true
				a.ZIndex = 10
				a.Size = n.Size
				a.Transparency = 1
				a.Color3 = Color3.new(1, 1, 1)
				a:SetAttribute("OWNER", player.Name)
				table.insert(ESPBXF, a)
			end
		end
		local function SetConnections()
			Connections[1] = player.Character:FindFirstChildOfClass("Humanoid").Changed:Connect(function()
				if player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
					b.Text = player.Name.." | HP: "..player.Character:FindFirstChildOfClass("Humanoid").Health
				end
			end)
			Connections[2] = player.Character:FindFirstChildOfClass("Humanoid").Died:Connect(function()
				b.Text = player.Name.." | DIED"
				Connections[1] = 1
				Connections[1] = 2
			end)
			for _, q in pairs(ESPBXF) do
				if player.Character:FindFirstChild(q.Name:split("|")[2]) then
					q.Adornee = player.Character:FindFirstChild(q.Name:split("|")[2])
				end
			end
		end
		player.CharacterAdded:Connect(function(char)
			repeat wait() until char:FindFirstChildOfClass("Humanoid")
			SetConnections()
		end)
		spawn(function()
			while true do
				if player.Character then
					if player.Character:FindFirstChild("Head") then
						a.Adornee = player.Character.HumanoidRootPart
					end
				end
				wait(3)
			end
		end)
	end)
	game.Players.PlayerRemoving:Connect(function(plr)
		if ESPFolder:FindFirstChild(plr.Name) then
			ESPFolder:FindFirstChild(plr.Name):Destroy()
		end
	end)
end

